{
  "description": "Sanitized schema-shaped gold floors for offline_gold_matrix. No device identity.",
  "methods": {
    "get_facts": {
      "hostname": "sample-host",
      "vendor": "Belden"
    },
    "get_mrp": {
      "ff:ff:ff:ff:ff:ff:ff:ff:ff:ff:ff:ff:ff:ff:ff:ff": {
        "vlan": 100,
        "operation": true,
        "role": "manager",
        "ring_port1": "1/1",
        "ring_port2": "1/2",
        "ring_port1_state": "forwarding",
        "ring_state": "closed"
      }
    },
    "get_dns": {
      "enabled": false,
      "timeout": 3,
      "retransmits": 2
    },
    "get_banner": {
      "pre_login_enabled": false,
      "pre_login_text": ""
    },
    "get_interfaces": {
      "1": {
        "admin_status": "enabled",
        "mtu": 1518,
        "oper_status": "up"
      },
      "2": {
        "admin_status": "enabled",
        "mtu": 1518,
        "oper_status": "up"
      }
    },
    "get_ntp": {
      "enabled": false,
      "request_interval": 30,
      "server_enabled": false,
      "server_stratum": 1
    },
    "get_syslog": {
      "enabled": false
    },
    "get_hidiscovery": {
      "enabled": true,
      "mode": "readWrite",
      "relay_enabled": false,
      "blinking": false
    },
    "get_login_policy": {
      "min_length": 6,
      "max_attempts": 0,
      "lockout_time": 0,
      "min_uppercase": 1,
      "min_lowercase": 1,
      "min_numeric": 1,
      "min_special": 1
    },
    "get_gvrp": {
      "enabled": false
    },
    "get_gmrp": {
      "enabled": false,
      "unknown_multicast": "discard"
    },
    "get_dai_global": {
      "validate_src_mac": false,
      "validate_dst_mac": false,
      "validate_ip": false
    },
    "get_dhcp_snooping": {
      "enabled": false,
      "verify_mac": false
    },
    "get_session_config": {
      "ssh_timeout": 5,
      "telnet_timeout": 5,
      "web_timeout": 5,
      "max_ssh_sessions": 5
    },
    "get_snmp_config": {
      "v1_enabled": false,
      "v2_enabled": false,
      "v3_enabled": true,
      "port": 161,
      "trap_service": true
    },
    "get_services": {
      "http": {
        "enabled": true,
        "port": 80
      },
      "https": {
        "enabled": true,
        "port": 443
      },
      "telnet": {
        "enabled": false,
        "port": 23
      },
      "ssh": {
        "enabled": true,
        "port": 22
      },
      "snmp_v1": {
        "enabled": false
      },
      "snmp_v2": {
        "enabled": false
      },
      "snmp_v3": {
        "enabled": true
      }
    },
    "get_rstp": {
      "enabled": true,
      "priority": 32768,
      "hello_time": 2,
      "max_age": 20,
      "forward_delay": 15,
      "bpdu_guard": false
    },
    "get_loop_protection": {
      "enabled": 2,
      "transmission_interval": 5,
      "rx_threshold": 1
    },
    "get_vlan_ingress": {
      "1": {
        "pvid": 1,
        "ingress_filtering": false,
        "acceptable_frame_types": "admitAll"
      },
      "2": {
        "pvid": 1,
        "ingress_filtering": false,
        "acceptable_frame_types": "admitAll"
      }
    },
    "get_auto_disable_reasons": {
      "1": {
        "enabled": false
      },
      "4": {
        "enabled": false
      }
    },
    "get_snmp_information": {
      "chassis_id": "sample-host",
      "contact": "example-contact",
      "location": "example-rack"
    },
    "get_qos": {
      "port_trust_mode": {
        "1": 2,
        "2": 2
      }
    },
    "get_remote_auth": {
      "ldap_enabled": false
    },
    "get_system_info": {
      "hostname": "sample-host",
      "contact": "example-contact",
      "location": "example-rack"
    },
    "get_port_security": {
      "global_enabled": false
    },
    "get_rstp_port": {
      "1/1": {
        "enabled": true
      },
      "1/2": {
        "enabled": true
      }
    }
