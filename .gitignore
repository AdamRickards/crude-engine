# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
report.json
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*,cover
.hypothesis/

# Translations
*.mo
*.pot

# Django stuff:
*.log

# Sphinx documentation
docs/_build/

# PyBuilder
target/

#Ipython Notebook
.ipynb_checkpoints

# Virtual environments
.venv/
venv/

# Local captures / archives — not for the repo.
# Generators stay committed so CI can run them.
local/reference/
local/archive/
local/tools/

# Patch files
*.patch

# Vendor MIB files (reference only, from firmware)
MIBs/

# sFlow reference files (used for SNOOP)
/tools/snoop/sFlow/

# Runtime artifacts
.pytest_cache/
.wrangler/
logs/

# OS / editor
.DS_Store
*.swp
*~
.idea/

# Extra tool caches
.mypy_cache/
.ruff_cache/

# Secrets / keys (never commit)
.env
.env.*
*.pem
id_rsa
id_ed25519

